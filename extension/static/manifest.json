{
  "manifest_version": 3,
  "name": "vault",
  "version": "0.0.0",
  "description": "A single-user, zero-knowledge password manager that syncs through vault serve.",
  "browser_specific_settings": {
    "gecko": {
      "id": "vault@codeheadsystems.com",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "vault",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "clipboardRead",
    "publicSuffix",
    "webNavigation",
    "menus"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Fill the login for this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'"
  },
  "web_accessible_resources": []
}
