<?xml version="1.0" encoding="utf-8"?>
<!--
  Release: no cleartext anywhere, loopback included, and the system authorities only, never
  user-installed ones (docs/android.md, Transport). src/debug overrides this file for tests.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
